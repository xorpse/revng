.clang-format

# Out-of-tree and local CMake builds
/build/
/build-*/
/cmake-build-*/

# Python caches and test output
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Rust build output (Cargo.lock files remain visible)
target/

# Locally provisioned toolchain and staged install trees
/revng-llvm/
/revng-llvm-build/
/revng-llvm-install/
/revng-nanobind/
/revng-nanobind-build/
/revng-nanobind-install/
/revng-nanobind-standalone-build/
/stage-*/
/.venv*/

# Local planning notes and scratch sources
/plans/
